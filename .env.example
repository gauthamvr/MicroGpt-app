EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ─── iOS-only: Google Sign-In ──────────────────────────────────────────
# Create an "iOS" OAuth client in Google Cloud Console for bundle id
# com.anonymous.MicroGpt. It gives you two forms of the same id:
#   - forward:  1234-abcd.apps.googleusercontent.com   -> IOS_CLIENT_ID
#   - reversed: com.googleusercontent.apps.1234-abcd   -> IOS_URL_SCHEME
# Android does not need these.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234-abcd.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.1234-abcd
