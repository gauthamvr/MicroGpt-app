# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# server env
server/.env

# typescript
*.tsbuildinfo

app-example

# IDE
.idea/
.vscode/

# Android build outputs
android/build/
android/app/build/
android/.gradle/
android/.cxx/
android/app/.cxx/

# Native module build outputs (generated during local builds)
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/

# Native iOS app project — generated by EAS prebuild on its macOS builder
# (a Windows dev machine cannot generate it). Kept OUT of git so EAS always
# regenerates it fresh from app.config.js + the module podspecs. The leading
# slash anchors this to the repo root so it does NOT ignore the hand-written
# Swift sources under modules/*/ios/.
/ios/

# Screenshots
screenshot*.png
build-output/

# Local agent/editor tooling
.claude/
.mcp.json

# Native image-gen binaries — NOT redistributable from this repo.
#   libsd-server.so           MIT, build it: npm run build:sd-server
#   libstable_diffusion_core.so  CC BY-NC 4.0 (xororz/local-dream)
#   qnnlibs/*.so              proprietary Qualcomm QNN runtime
# See CREDITS.md and docs/UPDATING.md sections 2-4.
modules/expo-stable-diffusion/android/src/main/jniLibs/
modules/expo-stable-diffusion/android/src/main/assets/qnnlibs/
