<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow cleartext HTTP to localhost/127.0.0.1 for the subprocess
  inference servers (local-dream on port 18081, sd-server on port 8087).

  Android 9+ (API 28+) blocks cleartext HTTP by default. Debug builds
  bypass this via android:debuggable="true", but release/Play Store
  builds do NOT — causing the health-check polling to silently fail
  and the model load to time out after 120 seconds.

  The reference project (off-grid-mobile-ai) uses the same approach.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
