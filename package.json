{
  "name": "microgpt",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "setup-native": "patch-package && node node_modules/llama.rn/install/download-native-artifacts.js",
    "install:windows": "npm install --ignore-scripts && npm run setup-native",
    "check-16k": "node scripts/check-16k-alignment.js",
    "build:sd-server": "bash scripts/build-sd-server.sh"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^5.1.2",
    "@react-native-google-signin/google-signin": "^13.3.1",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@supabase/supabase-js": "^2.101.1",
    "dotenv": "^17.4.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "expo": "~55.0.19",
    "expo-auth-session": "~55.0.15",
    "expo-blur": "~55.0.14",
    "expo-constants": "^55.0.11",
    "expo-crypto": "~55.0.14",
    "expo-dev-client": "~55.0.30",
    "expo-device": "~55.0.15",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.17",
    "expo-font": "^55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image-picker": "~55.0.19",
    "expo-linking": "~55.0.14",
    "expo-notifications": "~55.0.22",
    "expo-router": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "^55.0.5",
    "expo-symbols": "^55.0.7",
    "expo-system-ui": "~55.0.16",
    "expo-web-browser": "~55.0.14",
    "llama.rn": "^0.12.0-rc.9",
    "lodash": "^4.17.21",
    "nativewind": "^4.2.3",
    "prettier": "^3.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-blob-util": "^0.24.7",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-swiper": "^1.6.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "^0.7.4",
    "unique-names-generator": "^4.7.1",
    "unique-username-generator": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.10",
    "@types/react-test-renderer": "^18.3.0",
    "babel-preset-expo": "^55.0.8",
    "jest": "^29.2.1",
    "jest-expo": "^55.0.13",
    "patch-package": "^8.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.2"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "comment": "expo-stable-diffusion and expo-download-manager are LOCAL modules under ./modules, not npm packages, so React Native Directory has no metadata for them. Exclude to silence the false-positive doctor warning.",
        "exclude": ["expo-stable-diffusion", "expo-download-manager"],
        "listUnknownPackages": false
      }
    }
  }
}
